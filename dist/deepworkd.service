[Unit]
Description=DeepWork focus daemon
Documentation=file:///usr/local/share/doc/deepwork/PLAN.md
After=network-pre.target
Wants=network-pre.target
# RefuseManualStop=yes is added at runtime, only while a session runs
# (/run/systemd/system/deepworkd.service.d/50-session.conf).

[Service]
Type=notify
ExecStart=/usr/local/bin/deepworkd
# Re-read the config. Loosening changes wait 24 hours.
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=1
StateDirectory=deepwork
StateDirectoryMode=0700
RuntimeDirectory=deepwork
RuntimeDirectoryMode=0755
ConfigurationDirectory=deepwork
# The daemon needs root for nft, tc, ip and the resolved drop-in, but nothing
# from users' home directories.
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target

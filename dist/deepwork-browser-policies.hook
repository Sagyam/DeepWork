# Installed by DeepWork as /etc/pacman.d/hooks/deepwork-browser-policies.hook.
# Browser package updates replace distribution/policies.json; put the
# DeepWork policies (DNS-over-HTTPS and ECH off) back right away. The daemon
# also re-applies them every minute.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = opt/zen-browser*/distribution/policies.json
Target = usr/lib/zen-browser/distribution/policies.json
Target = usr/lib/firefox/distribution/policies.json

[Action]
Description = Re-applying DeepWork browser policies...
When = PostTransaction
Exec = /usr/local/bin/deepworkd --browser-policies apply
